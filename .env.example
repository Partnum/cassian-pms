# ============================================================
#  Cassian PMS — Environment configuration  (PostgreSQL)
#  Copy this file to ".env" and adjust the values.
# ============================================================

# ---- Server ----
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:4000

# ---- Database ----
# DB_MODE selects the database backend:
#   pglite = in-process PostgreSQL (WebAssembly). ZERO setup — no server, no
#            install, no connection string. Data is stored in ./data/pglite.
#            ★ RECOMMENDED to get started: just Node.js is required.
#   pg     = a real PostgreSQL server (local install, Supabase, Neon, Render…)
#            configured via DATABASE_URL or the PG* variables below.
# If DB_MODE is left blank, the app uses pg when DATABASE_URL is set, else pglite.
DB_MODE=pglite
# Where PGlite stores its data folder (optional; default ./data/pglite).
# PGLITE_DIR=./data/pglite

# OPTION A — Cloud / server PostgreSQL (only used when DB_MODE=pg). Paste the URL here.
#   Neon:     postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/cassian_pms?sslmode=require
#   Supabase: postgresql://postgres.<ref>:pass@aws-0-<region>.pooler.supabase.com:5432/postgres
# DATABASE_URL=
# SSL is auto-enabled for Neon/Supabase/Render/Railway/AWS or any ?sslmode=require URL.
# Force it with PGSSL=true (or PGSSL=false to disable).
# PGSSL=true
#
# OPTION B — Local PostgreSQL server (only used when DB_MODE=pg and DATABASE_URL is empty)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=cassian_pms

# ---- JWT secrets (CHANGE THESE to long random strings in production) ----
JWT_ACCESS_SECRET=change_me_access_secret_please_use_a_long_random_string
JWT_REFRESH_SECRET=change_me_refresh_secret_please_use_a_long_random_string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# ---- Seed default password (used by seed.sql / npm run seed) ----
SEED_PASSWORD=Password123!

# ============================================================
#  Google Drive integration
#  Enable the Google Drive API, create an OAuth 2.0 Web client,
#  redirect URI:  http://localhost:4000/api/v1/drive/callback
# ============================================================
# DRIVE_MODE = google (real Drive) | local (save uploads to ./uploads)
DRIVE_MODE=local
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/drive/callback
DRIVE_ROOT_FOLDER=Cassian Clients
# Background Drive sync (Drive Changes API). Cron expression; default every 10 min.
DRIVE_SYNC_CRON=*/10 * * * *
# Optional: encrypt stored OAuth tokens at rest (any passphrase; AES-256-GCM). Leave blank in dev.
TOKEN_ENC_KEY=

# ---- OCR / document text extraction ----
# OCR_MODE = off (decode text files only) | vision (Google Cloud Vision for images) | tesseract (reserved)
OCR_MODE=off
OCR_API_KEY=
OCR_BASE_URL=https://vision.googleapis.com/v1/images:annotate

# ============================================================
#  AI assistant (OpenAI-compatible Chat Completions API)
# ============================================================
# AI_MODE = openai (real) | mock (deterministic, no key needed)
AI_MODE=mock
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# ---- Email (optional) reminders via SMTP ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Cassian PMS <no-reply@cassian.co.tz>

# ---- Reminder scheduler ----
ENABLE_SCHEDULER=true
REMINDER_CRON=0 7 * * *

# ---- (Optional) Production PostgreSQL via Supabase/Neon ----
# To switch from the zero-setup PGlite mode to a real cloud database, set
# DB_MODE=pg above and uncomment + fill these two lines with YOUR OWN values.
# IMPORTANT: never commit real credentials. Encode special characters in the
# password (e.g. "@" becomes "%40"). Use the Supabase "Session pooler" URL (port 5432).
# DATABASE_URL=postgresql://postgres.<your-ref>:<your-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# PGSSL=true